# --- Auditify Backend Environment Configuration ---

# Database connection string - PostgreSQL ONLY (Supabase in production).
# Supabase PostgreSQL (replace <project-ref> and <your-db-password>):
# DATABASE_URL=postgresql://postgres:<your-db-password>@db.<project-ref>.supabase.co:5432/postgres
# Supabase session pooler (use this if your network has no IPv6 route):
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://auditify:auditify@localhost:5432/auditify
DATABASE_URL=postgresql+psycopg2://auditify:auditify@localhost:5432/auditify

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Default LLM model used for AI-driven checks and RAG copilot
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b

# Directory where ChromaDB persists its vector store
CHROMA_PERSIST_DIR=./chroma_store

# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Max upload size per file, in megabytes
MAX_UPLOAD_MB=15

# --- Auth / JWT ---
# HMAC key used to sign access/refresh tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret
# Access token lifetime (minutes) and refresh token lifetime (days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
