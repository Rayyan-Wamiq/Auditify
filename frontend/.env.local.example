# =============================================================================
# Auditify - local environment template (copy to `.env.local`)
#
# NEVER commit the real `.env.local` (it is git-ignored) and never paste these
# values into source code, docs or issues.
#
# The API now runs inside this Next.js app (`app/api/**`), so these variables are
# read by the route handlers on the server. Only `NEXT_PUBLIC_*` variables are
# ever exposed to the browser.
# =============================================================================

# --- Database: Supabase or local PostgreSQL --------------------------------
# Supabase connection pooler (recommended for serverless: HTTPS-friendly, IPv4):
# DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local PostgreSQL (also used by docker-compose.yml):
DATABASE_URL=postgresql://auditify:auditify@localhost:5432/auditify

# --- Groq LLM (https://console.groq.com/keys) ------------------------------
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=openai/gpt-oss-120b

# --- Auth / JWT -------------------------------------------------------------
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App --------------------------------------------------------------------
MAX_UPLOAD_MB=15

# --- Optional: remote embeddings for the RAG copilot ------------------------
# Left unset (the default) the copilot uses the deterministic, dependency-free
# lexical embedder - no external calls, no local model download.
# EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=512

# --- Optional: proxy /api/* to an external backend --------------------------
# Set this only to keep using the legacy FastAPI service (or a staging API);
# when unset, /api/* is served by this app's route handlers.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

